{
  "name": "prontopreco-desktop",
  "productName": "ProntoPreço",
  "version": "1.1.0",
  "description": "Sistema de consulta de preços, scanner de código de barras e estoque com sincronização em nuvem.",
  "main": "main.cjs",
  "author": "ProntoPreço",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.prontopreco.desktop",
    "productName": "ProntoPreço",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "dist/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "artifactName": "ProntoPreco-Instalador-Windows.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "ProntoPreco-Portatil-Windows.exe"
    }
  }
}
